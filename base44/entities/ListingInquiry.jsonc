{
  "name": "ListingInquiry",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "sender_contact_email": {
      "type": "string"
    },
    "sender_contact_phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "read",
        "replied",
        "archived"
      ],
      "default": "sent"
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_off_market": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "listing_id",
    "sender_id",
    "recipient_id",
    "message"
  ]
}